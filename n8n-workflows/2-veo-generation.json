{
  "name": "Minecraft Horror - Veo Video Generation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 4 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM content_queue WHERE status = 'approved' AND approved = true ORDER BY created_at ASC LIMIT 5"
      },
      "id": "fetch-approved",
      "name": "Fetch Approved Content",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [420, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length || 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "has-content",
      "name": "Has Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/veo-2:generateVideo",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.veo_prompt }}\",\n  \"config\": {\n    \"numberOfVideos\": 1,\n    \"durationSeconds\": 8,\n    \"aspectRatio\": \"9:16\",\n    \"resolution\": \"1080p\"\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "veo-api-call",
      "name": "Veo 2 Generate Video (Placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 200],
      "notes": "Replace URL and auth with actual Veo 2 API endpoint when available. This is a placeholder structure."
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst contentId = input.id || input.content_id;\nconst videoUrl = input.videoUrl || input.video_url || input.result?.videoUrl || 'pending-manual-review';\n\nreturn [{\n  json: {\n    content_id: contentId,\n    video_url: videoUrl,\n    status: videoUrl !== 'pending-manual-review' ? 'generated' : 'approved'\n  }\n}];"
      },
      "id": "extract-video-url",
      "name": "Extract Video URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE content_queue SET status = '{{ $json.status }}', veo_video_url = '{{ $json.video_url }}', updated_at = NOW() WHERE id = '{{ $json.content_id }}'"
      },
      "id": "update-status",
      "name": "Update Content Status",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1300, 200],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "console.log(`Video generation complete. Content ID: ${$input.first().json.content_id}`);\nreturn [$input.first()];"
      },
      "id": "log-complete",
      "name": "Log Completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 200]
    },
    {
      "parameters": {},
      "id": "no-content",
      "name": "No Content to Process",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [860, 420]
    }
  ],
  "connections": {
    "Daily 4 AM Trigger": {
      "main": [
        [
          {
            "node": "Fetch Approved Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Approved Content": {
      "main": [
        [
          {
            "node": "Has Content?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Content?": {
      "main": [
        [
          {
            "node": "Veo 2 Generate Video (Placeholder)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Content to Process",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Veo 2 Generate Video (Placeholder)": {
      "main": [
        [
          {
            "node": "Extract Video URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Video URL": {
      "main": [
        [
          {
            "node": "Update Content Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Content Status": {
      "main": [
        [
          {
            "node": "Log Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "minecraft-horror"
    }
  ]
}
